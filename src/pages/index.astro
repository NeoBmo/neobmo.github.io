---
import Base from "../layouts/Base.astro";
import Backdrop from "../components/Backdrop.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import Sections from "../components/Sections.astro";
import Waypoints from "../components/Waypoints.astro";
---

<Base>
  <Backdrop />
  <Waypoints />
  <main data-rails>
    <Hero />
    <Sections />
    <Projects />
    <Sections afterProjects />
  </main>
</Base>

<script>
  import { mountRails } from "../scripts/rails";
  import { mountScenes } from "../scripts/scenes";
  import { mountSheets } from "../scripts/sheets";
  import { mountWaypoints } from "../scripts/waypoints";

  mountRails();
  mountScenes();
  mountSheets();
  mountWaypoints();
</script>
