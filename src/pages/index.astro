---
import Base from "../layouts/Base.astro";
import Backdrop from "../components/Backdrop.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import Sections from "../components/Sections.astro";
import Waypoints from "../components/Waypoints.astro";
import { getEntry } from "astro:content";

// Datos estructurados para Google: quién es el autor y dónde más está. Los
// perfiles salen de la sección de contacto, para no repetirlos aquí.
const contact = await getEntry("sections", "contacto");
// Con barra final, igual que el canonical y el sitemap.
const home = new URL(import.meta.env.BASE_URL.replace(/\/?$/, "/"), Astro.site).href;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${home}#website`, url: home, name: "NeoBmo", inLanguage: "es" },
    {
      "@type": "Person",
      "@id": `${home}#person`,
      name: "Luis Rodríguez",
      alternateName: "NeoBmo",
      url: home,
      sameAs: contact?.data.links.map(({ url }) => url) ?? [],
    },
  ],
};
---

<Base>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Backdrop />
  <Waypoints />
  <main data-rails>
    <Hero />
    <Sections />
    <Projects />
    <Sections afterProjects />
  </main>
</Base>

<script>
  import { mountRails } from "../scripts/rails";
  import { mountScenes } from "../scripts/scenes";
  import { mountSheets } from "../scripts/sheets";
  import { mountWaypoints } from "../scripts/waypoints";

  mountRails();
  mountScenes();
  mountSheets();
  mountWaypoints();
</script>
