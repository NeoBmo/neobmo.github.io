---
import Base from "../layouts/Base.astro";
import Backdrop from "../components/Backdrop.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import Sections from "../components/Sections.astro";
import Waypoints from "../components/Waypoints.astro";
import { getEntry } from "astro:content";
import { LANDSCAPE_QUERY, PAINTINGS, PORTRAIT_QUERY } from "../lib/painting";
import { isProfile } from "../lib/url";

// Datos estructurados para Google: quién es el autor y dónde más está. Los
// perfiles salen de la sección de contacto, para no repetirlos aquí.
const contact = await getEntry("sections", "contacto");
// Con barra final, igual que el canonical y el sitemap.
const home = new URL(import.meta.env.BASE_URL.replace(/\/?$/, "/"), Astro.site).href;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${home}#website`, url: home, name: "NeoBmo", inLanguage: "es" },
    {
      "@type": "Person",
      "@id": `${home}#person`,
      name: "Luis Rodríguez",
      alternateName: "NeoBmo",
      jobTitle: "Desarrollador web",
      knowsAbout: ["Desarrollo frontend", "React", "TypeScript", "Automatización de procesos", "IA aplicada al desarrollo"],
      url: home,
      sameAs: contact?.data.links.map(({ url }) => url).filter(isProfile) ?? [],
    },
  ],
};
---

<Base>
  {/*
    La pintura se pide al leer el HTML, a la vez que el JS y la fuente; si no,
    la pide el hero cuando ya cargó todo lo demás. Sólo baja la que encaja.
  */}
  <link slot="head" rel="preload" as="image" type="image/webp" href={PAINTINGS.portrait.url} media={PORTRAIT_QUERY} />
  <link slot="head" rel="preload" as="image" type="image/webp" href={PAINTINGS.landscape.url} media={LANDSCAPE_QUERY} />
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Backdrop />
  <Waypoints />
  <main data-rails>
    <Hero />
    <Sections />
    <Projects />
    <Sections afterProjects />
  </main>
</Base>

<script>
  import { mountRails } from "../scripts/rails";
  import { mountScenes } from "../scripts/scenes";
  import { mountSheets } from "../scripts/sheets";
  import { mountWaypoints } from "../scripts/waypoints";

  mountRails();
  mountScenes();
  mountSheets();
  mountWaypoints();
</script>
