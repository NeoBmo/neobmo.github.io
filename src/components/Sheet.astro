---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
// Más largos que cualquier pantalla: el marco los recorta a su medida.
const ROW = "-".repeat(400);
const COLUMN = "|\n".repeat(200);
// La parte leída del borde: una raya gruesa por fila, como una barra de terminal.
const FILLED = "┃\n".repeat(200);
---

<dialog class="sheet" id={id} aria-labelledby={`${id}-title`}>
  <div class="sheet__frame" aria-hidden="true">
    <span class="sheet__edge sheet__edge--top">{ROW}</span>
    <span class="sheet__edge sheet__edge--bottom">{ROW}</span>
    <span class="sheet__edge sheet__edge--left">{COLUMN}</span>
    <span class="sheet__edge sheet__edge--right">{COLUMN}</span>
    <!-- El borde derecho hace de barra: se enciende hasta donde se ha leído. -->
    <span class="sheet__edge sheet__edge--right sheet__progress">{FILLED}</span>
    <span class="sheet__corner sheet__corner--top sheet__corner--left">+</span>
    <span class="sheet__corner sheet__corner--top sheet__corner--right">+</span>
    <span class="sheet__corner sheet__corner--bottom sheet__corner--left">+</span>
    <span class="sheet__corner sheet__corner--bottom sheet__corner--right">+</span>
  </div>
  <!-- Fuera del texto que se desplaza: cerrar queda siempre a mano. -->
  <form method="dialog" class="sheet__bar">
    <button>[ cerrar ]</button>
  </form>
  <div class="sheet__body" data-sheet-body>
    <h2 id={`${id}-title`} class="sheet__title">{title}</h2>
    <slot />
  </div>
</dialog>

<style>
  /* Registradas para que el degradado pueda aparecer poco a poco y valga 0 sin medir. */
  @property --fade-top {
    syntax: "<length>";
    inherits: true;
    initial-value: 0px;
  }

  @property --fade-bottom {
    syntax: "<length>";
    inherits: true;
    initial-value: 0px;
  }

  /* Una ventana dentro de la página: leer más no saca al visitante del recorrido. */
  .sheet {
    width: min(76ch, 100vw - 2 * var(--space-gutter));
    max-width: none;
    max-height: calc(100svh - 2 * var(--space-gutter));
    padding: 0;
    overflow: hidden;
    color: var(--color-signal);
    background: var(--color-void);
    border: 0;
  }

  .sheet[open] {
    display: flex;
    flex-direction: column;
  }

  .sheet::backdrop {
    background: rgb(0 0 0 / 0.8);
  }

  /* El texto se desplaza dentro; el marco se queda quieto. */
  .sheet__body {
    min-height: 0;
    /* Un carácter de margen: el texto y su barra quedan dentro del marco. */
    margin: 0 1ch 1.2em;
    padding: 0.4em clamp(0.8em, 5vw, 2.6em) 1.4em;
    overflow-y: auto;
    /* La barra del sistema sobra: el progreso lo marca el borde del marco. */
    scrollbar-width: none;
    /* Al llegar al final, el scroll no pasa a la página de detrás. */
    overscroll-behavior: contain;
    /* El texto se desvanece por donde queda más: arriba si ya se bajó, abajo
       si falta. Sin JavaScript no hay medida y no se desvanece nada. */
    mask-image: linear-gradient(
      transparent,
      #000 var(--fade-top),
      #000 calc(100% - var(--fade-bottom)),
      transparent
    );
  }

  .sheet__body::-webkit-scrollbar {
    display: none;
  }

  .sheet[data-more-above] {
    --fade-top: 2.5em;
  }

  .sheet[data-more-below] {
    --fade-bottom: 2.5em;
  }

  /* Solo se enciende si hay algo que recorrer: hasta donde llega lo visto. */
  .sheet__progress {
    display: none;
    color: var(--color-signal);
    clip-path: inset(0 0 calc((1 - var(--progress, 0)) * 100%) 0);
  }

  .sheet[data-more-above] .sheet__progress,
  .sheet[data-more-below] .sheet__progress {
    display: block;
  }

  .sheet__title {
    margin: 0 0 0.6em;
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  /* Jerarquía para leer por encima: el título manda, las secciones son
     etiquetas de terminal y cada entrada abre con su nombre. El texto llega
     de Markdown, así que estas reglas no llevan el ámbito del componente. */
  .sheet__body :global(h2:not(.sheet__title)),
  .sheet__body:has(:global(.resume-head)) .sheet__title {
    margin: 2.2em 0 0.8em;
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-dim);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  /* En la hoja de vida el título es una etiqueta más: el nombre es lo que manda. */
  .sheet__body:has(:global(.resume-head)) .sheet__title {
    margin-top: 0;
  }

  .sheet__body :global(h2:not(.sheet__title))::before,
  .sheet__body:has(:global(.resume-head)) .sheet__title::before {
    content: "## ";
  }

  .sheet__body :global(h3) {
    margin: 1.6em 0 0;
    font-size: var(--text-base);
    font-weight: 700;
    line-height: 1.4;
  }

  /* La etiqueta se pega a lo que encabeza: más cerca de su texto que del anterior. */
  .sheet__body :global(h2 + :is(h3, p, ul)) {
    margin-top: 0;
  }

  .sheet__body :global(:is(.resume-meta, .resume-tools)) {
    margin: 0.1em 0 0.5em;
    font-size: var(--text-sm);
    color: var(--color-dim);
  }

  .sheet__body :global(.resume-tools) {
    margin: 0.5em 0 0;
  }

  /* La foto abre la cabecera por la izquierda, en la misma línea que el resto
     del texto, y el nombre se apoya a su lado. En blanco y negro, con el ruido
     del lienzo quieto detrás de la silueta. */
  .sheet__body :global(.resume-photo) {
    position: relative;
    float: left;
    width: 9.5rem;
    aspect-ratio: 1;
    /* El margen de un flotante no se funde con el del título siguiente: aquí
       va la separación que la etiqueta de abajo no puede dar. */
    margin: 0 1.4em 1.8em 0;
    overflow: hidden;
  }

  /* El nombre ocupa la columna que deja la foto, sin colarse debajo de ella. */
  .sheet__body :global(.resume-head) {
    display: flow-root;
    padding-top: 0.6em;
  }

  .sheet__body :global(.resume-head + h2) {
    clear: both;
  }

  /* En un celular no caben las dos columnas: la foto va encima, más grande. */
  @media (max-width: 30rem) {
    .sheet__body :global(.resume-photo) {
      float: none;
      width: 10rem;
      margin: 0 0 1em;
    }

    .sheet__body :global(.resume-head) {
      padding-top: 0;
    }
  }

  .sheet__body :global(.resume-photo__noise) {
    position: absolute;
    inset: 0;
    font-size: 0.7rem;
    line-height: 1.2;
    color: var(--color-dim);
    white-space: pre;
  }

  .sheet__body :global(.resume-photo img) {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    filter: grayscale(1) contrast(1.1);
  }

  .sheet__body :global(.resume-head p) {
    margin: 0;
  }

  /* Bajo el nombre, lo que soy y dónde: en gris, aparte del texto que se lee. */
  .sheet__body :global(.resume-head p:nth-child(2)) {
    color: var(--color-dim);
  }

  .sheet__body :global(.resume-head p:first-child) {
    margin-bottom: 0.2em;
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  .sheet__body :global(.resume-links) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em 1.4em;
    margin-top: 0.8em !important;
  }

  .sheet__bar {
    display: flex;
    flex: none;
    justify-content: flex-end;
    margin: 1.2em 1ch 0;
    padding: 0 clamp(0.8em, 5vw, 2.6em);
  }

  .sheet__bar button {
    padding: 0;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--color-dim);
    cursor: pointer;
    background: none;
    border: 0;
  }

  .sheet__bar button:hover {
    color: var(--color-signal);
  }

  /* El marco son caracteres, como todo lo demás: filas y columnas recortadas. */
  .sheet__frame {
    position: absolute;
    inset: 0;
    font-size: var(--text-sm);
    line-height: 1.3;
    color: var(--color-dim);
    pointer-events: none;
  }

  .sheet__edge,
  .sheet__corner {
    position: absolute;
    white-space: pre;
  }

  .sheet__edge {
    overflow: hidden;
  }

  .sheet__edge--top,
  .sheet__edge--bottom {
    right: 0;
    left: 0;
    height: 1.3em;
  }

  .sheet__edge--left,
  .sheet__edge--right {
    top: 0;
    bottom: 0;
    width: 1ch;
  }

  .sheet__edge--top,
  .sheet__corner--top {
    top: 0;
  }

  .sheet__edge--bottom,
  .sheet__corner--bottom {
    bottom: 0;
  }

  .sheet__edge--left,
  .sheet__corner--left {
    left: 0;
  }

  .sheet__edge--right,
  .sheet__corner--right {
    right: 0;
  }

  /* Las esquinas tapan el cruce de una fila con una columna. */
  .sheet__corner {
    background: var(--color-void);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Se enciende como la terminal: una línea que se abre. */
    .sheet {
      opacity: 0;
      transform: scaleY(0.04);
      transition:
        opacity 0.2s var(--ease-out),
        transform 0.25s var(--ease-out),
        overlay 0.25s allow-discrete,
        display 0.25s allow-discrete;
    }

    .sheet[open] {
      opacity: 1;
      transform: none;
    }

    .sheet__body {
      transition:
        --fade-top 0.2s var(--ease-out),
        --fade-bottom 0.2s var(--ease-out);
    }

    @starting-style {
      .sheet[open] {
        opacity: 0;
        transform: scaleY(0.04);
      }
    }
  }
</style>
