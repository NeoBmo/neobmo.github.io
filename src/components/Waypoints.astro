---
import { getCollection } from "astro:content";

const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;
const sections = (await getCollection("sections")).sort(byOrder);
const projects = (await getCollection("projects")).sort(byOrder);
const link = ({ id, data }: { id: string; data: { title: string } }) => ({
  target: id,
  label: data.title,
});

// El mismo orden que la portada: secciones, proyectos y el resto.
const stops = [
  ...sections.filter(({ data }) => !data.afterProjects).map(link),
  ...projects.map(({ id, data }) => ({ target: `proyecto-${id}`, label: data.title })),
  ...sections.filter(({ data }) => data.afterProjects).map(link),
];
---

<nav class="waypoints" aria-label="Paradas de la página" data-waypoints>
  <ol role="list">
    {
      stops.map(({ target, label }, index) => (
        <li style={`--order: ${index}`}>
          <a href={`#${target}`} data-label={label}>
            <span aria-hidden="true" data-glyph>
              ·
            </span>
            <span class="visually-hidden">{label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  /* Sin barra de scroll, esto dice dónde se está y cuánto falta. Está hecho de los
     mismos caracteres que el resto, y solo aparece mientras el visitante navega. */
  .waypoints {
    position: fixed;
    top: 50%;
    right: 0;
    z-index: 1;
    font-size: var(--text-sm);
    line-height: 1;
    transform: translateY(-50%);
  }

  /* Durante la intro no existe: la obra se presenta sola. */
  :global(html[data-stage="intro"]) .waypoints,
  :global(html[data-stage="greeting"]) .waypoints {
    visibility: hidden;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* El carácter es pequeño, pero el área que se toca no baja de 24 px. */
  a {
    position: relative;
    display: grid;
    place-items: center;
    width: max(var(--space-gutter), 1.5rem);
    height: 1.5rem;
    color: var(--color-dim);
    text-decoration: none;
  }

  /* La parada actual es la que brilla. */
  a[aria-current] {
    color: var(--color-signal);
  }

  a::after {
    position: absolute;
    right: 100%;
    padding: 0.3em 0.6em;
    color: var(--color-signal);
    white-space: nowrap;
    pointer-events: none;
    content: attr(data-label);
    background: var(--color-void);
    opacity: 0;
  }

  a:focus-visible::after {
    opacity: 1;
  }

  @media (hover: hover) {
    a:hover {
      color: var(--color-signal);
    }

    a:hover::after {
      opacity: 1;
    }
  }

  /* Con el script, en reposo se retira: no invita a saltarse el recorrido. Los
     caracteres entran y salen uno tras otro. */
  .waypoints[data-enhanced] li {
    opacity: 0;
    transform: translateX(0.8em);
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
    transition-delay: calc(var(--order) * 30ms);
  }

  .waypoints[data-enhanced]:not([data-awake]):not(:focus-within) {
    pointer-events: none;
  }

  .waypoints[data-awake] li,
  .waypoints:focus-within li {
    opacity: 1;
    transform: none;
  }
</style>
