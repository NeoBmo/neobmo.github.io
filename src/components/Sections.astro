---
import { getCollection, render } from "astro:content";
import Sheet from "./Sheet.astro";
import logoUrl from "../assets/logo.svg?url";
import { href } from "../lib/url";

interface Props {
  /** Qué secciones pintar: las que van antes de los proyectos o las de después. */
  afterProjects?: boolean;
}

const { afterProjects = false } = Astro.props;
const entries = (await getCollection("sections"))
  .filter(({ data }) => data.afterProjects === afterProjects)
  .sort((a, b) => a.data.order - b.data.order);
// El texto completo de cada sección va en la portada, en su ventana de lectura.
const sections = await Promise.all(
  entries.map(async (entry) => ({ ...entry, Content: (await render(entry)).Content })),
);
const year = new Date().getFullYear();
---

{
  sections.map(({ id, data, body, Content }) => {
    // Solo las secciones con cuerpo tienen algo más que leer.
    const more = body?.trim() && (
      <a href={href(id)} aria-label={`Seguir leyendo: ${data.title}`} data-sheet={`leer-${id}`}>
        Seguir leyendo
      </a>
    );

    return (
      <section
        class:list={["scene", data.finale ? "finale" : "reading"]}
        id={id}
        data-symbol={data.symbol}
        data-finale={data.finale ? "" : undefined}
        aria-labelledby={`${id}-title`}
      >
        {data.finale && <img class="finale__mark" src={logoUrl} alt="" width="500" height="500" />}
        <div
          class={
            data.finale
              ? "panel"
              : data.symbol
                ? "scene__body"
                : data.greeting.length > 0
                  ? "opening"
                  : "plain"
          }
          data-opening={data.greeting.length > 0 ? "" : undefined}
        >
          {data.greeting.length > 0 && (
            <p class="greeting" aria-hidden="true">
              {data.greeting.map((line) => (
                <span class="greeting__line">
                  &gt; <span data-greeting-line={line}>{line}</span>
                </span>
              ))}
            </p>
          )}
          {data.kicker && <p class="scene__note">{data.kicker}</p>}
          <h2 id={`${id}-title`} class:list={{ "visually-hidden": data.greeting.length > 0 }}>
            {data.title}
          </h2>
          <p>{data.summary}</p>
          {data.steps.length > 0 && (
            <ol class="steps" role="list">
              {data.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
          )}
          {data.links.length > 0 && (
            <ul class="scene__links contact" role="list">
              {data.links.map(({ label, url }) => (
                <li>
                  <a href={url} rel="me">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          )}
          {data.symbol ? (
            <p class="scene__links">
              {data.repo && (
                <a href={data.repo} aria-label={`Ver el repositorio de ${data.title}`}>
                  Ver repositorio
                </a>
              )}
              {more}
            </p>
          ) : (
            more
          )}
          {data.finale && (
            <footer class="scene__note signature">
              <span aria-hidden="true">\|°</span> NeoBmo · {year}
            </footer>
          )}
        </div>
        {more && (
          <Sheet id={`leer-${id}`} title={data.title}>
            <Content />
          </Sheet>
        )}
      </section>
    );
  })
}

<style>
  /* Sin símbolo, el contenedor no cuenta: el texto se coloca como antes de las escenas. */
  .plain {
    display: contents;
  }

  /* El saludo se escribe solo al acabar la intro y queda como título de la sección. */
  .greeting {
    margin: 0 0 0.6em;
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.4;
  }

  .greeting__line {
    display: block;
    white-space: pre;
  }

  /* El cursor va en la línea que se escribe; las siguientes esperan su turno. */
  .greeting__line[data-typing]::after {
    content: "█";
  }

  .greeting__line:not([data-typing]):has([data-greeting-line]:empty) {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .greeting__line[data-typing]::after {
      animation: blink 1s steps(1) infinite;
    }

    /* Al abrirse la página, el saludo sube a su sitio y el resto aparece. */
    .opening {
      transition: transform 1s var(--ease-out);
    }

    .opening > * {
      transition: opacity 0.8s var(--ease-out) 0.3s;
    }

    /* Durante la intro el bloque espera debajo del logo, y solo se ve el saludo. */
    :global(html[data-stage="intro"]) .opening,
    :global(html[data-stage="greeting"]) .opening {
      transform: translateY(var(--intro-shift, 0px));
      transition: none;
    }

    :global(html[data-stage="intro"]) .opening > *,
    :global(html[data-stage="greeting"]) .opening > :not(.greeting) {
      visibility: hidden;
      opacity: 0;
      transition: none;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* Solo en las escenas con símbolo o panel: las demás conservan el título de siempre. */
  .scene__body h2,
  .panel h2 {
    margin: 0.3em 0 0.4em;
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  /* Los pasos van numerados y en línea: se leen como un recorrido, no como una lista. */
  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em 1.2em;
    margin: 1em 0 0;
    padding: 0;
    font-size: var(--text-sm);
    color: var(--color-dim);
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step, decimal-leading-zero) " ";
  }

  /* El cierre: una sola columna centrada, igual en un teléfono que en escritorio.
     Arriba, el logo; debajo, la invitación a escribir. */
  .finale {
    justify-content: flex-start;
    align-items: center;
    padding: 0 var(--space-gutter) var(--space-gutter);
    text-align: center;
  }

  /* Guarda el sitio del logo, que arma el lienzo en ese mismo hueco. Sin lienzo
     animado (movimiento reducido) se ve la imagen. */
  .finale__mark {
    width: auto;
    height: 25svh;
    margin: 13svh 0 6svh;
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .finale__mark {
      visibility: visible;
    }
  }

  .panel {
    max-width: 44ch;
  }

  .panel h2 {
    margin-top: 0;
  }

  .contact {
    justify-content: center;
    padding: 0;
    list-style: none;
  }

  .signature {
    margin-top: 2.4em;
  }
</style>
