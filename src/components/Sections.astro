---
import { getCollection, render } from "astro:content";
import Sheet from "./Sheet.astro";
import logoUrl from "../assets/logo.svg?url";
import { href } from "../lib/url";

interface Props {
  /** Qué secciones pintar: las que van antes de los proyectos o las de después. */
  afterProjects?: boolean;
}

const { afterProjects = false } = Astro.props;
const entries = (await getCollection("sections"))
  .filter(({ data }) => data.afterProjects === afterProjects)
  .sort((a, b) => a.data.order - b.data.order);
// El texto completo de cada sección va en la portada, en su ventana de lectura.
const sections = await Promise.all(
  entries.map(async (entry) => ({ ...entry, Content: (await render(entry)).Content })),
);
const year = new Date().getFullYear();
---

{
  sections.map(({ id, data, body, Content }) => {
    // Solo las secciones con cuerpo tienen algo más que leer.
    const more = body?.trim() && (
      <a href={href(id)} aria-label={`Seguir leyendo: ${data.title}`} data-sheet={`leer-${id}`}>
        Seguir leyendo
      </a>
    );

    return (
      <section
        class:list={["scene", data.finale ? "finale" : "reading"]}
        id={id}
        data-symbol={data.symbol}
        data-finale={data.finale ? "" : undefined}
        aria-labelledby={`${id}-title`}
      >
        {data.finale && <img class="finale__mark" src={logoUrl} alt="" width="500" height="500" />}
        <div
          class={
            data.finale
              ? "panel"
              : data.symbol
                ? "scene__body"
                : data.greeting.length > 0
                  ? "opening"
                  : "plain"
          }
          data-opening={data.greeting.length > 0 ? "" : undefined}
        >
          {data.greeting.length > 0 && (
            <p class="greeting" aria-hidden="true" data-greeting={JSON.stringify(data.greeting)}>
              &gt; <span data-greeting-text>{data.greeting.at(-1)}</span>
              <span class="greeting__cursor">█</span>
            </p>
          )}
          {data.kicker && <p class="scene__note">{data.kicker}</p>}
          <h2 id={`${id}-title`} class:list={{ "visually-hidden": data.greeting.length > 0 }}>
            {data.title}
          </h2>
          <p>{data.summary}</p>
          {data.links.length > 0 && (
            <ul class="scene__links contact" role="list">
              {data.links.map(({ label, url }) => (
                <li>
                  <a href={url} rel="me">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          )}
          {data.symbol ? (
            <p class="scene__links">
              {data.repo && (
                <a href={data.repo} aria-label={`Ver el repositorio de ${data.title}`}>
                  Ver repositorio
                </a>
              )}
              {more}
            </p>
          ) : (
            more
          )}
          {data.finale && (
            <footer class="scene__note signature">
              <span aria-hidden="true">\|°</span> NeoBmo · {year}
            </footer>
          )}
        </div>
        {more && (
          <Sheet id={`leer-${id}`} title={data.title}>
            <Content />
          </Sheet>
        )}
      </section>
    );
  })
}

<style>
  /* Sin símbolo, el contenedor no cuenta: el texto se coloca como antes de las escenas. */
  .plain {
    display: contents;
  }

  /* Una línea de terminal: se escribe sola al acabar la intro y queda como título.
     En un teléfono la letra se ajusta al ancho para que la línea quepa entera
     (unos 32 caracteres); si ni así cabe, se parte en vez de salirse. */
  .greeting {
    margin: 0 0 0.6em;
    font-size: min(var(--text-lg), 4.6vw);
    font-weight: 600;
    line-height: 1.4;
    white-space: pre-wrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .greeting__cursor {
      animation: blink 1s steps(1) infinite;
    }

    /* Al abrirse la página, la terminal sube a su sitio y el resto aparece. */
    .opening {
      transition: transform 1s var(--ease-out);
    }

    .opening > * {
      transition: opacity 0.8s var(--ease-out) 0.3s;
    }

    /* Durante la intro el bloque espera con la terminal en el centro de la
       pantalla, y solo se ve ella. */
    :global(html[data-stage="intro"]) .opening,
    :global(html[data-stage="greeting"]) .opening,
    :global(html[data-stage="arrival"]) .opening {
      transform: translateY(var(--intro-shift, 0px));
      transition: none;
    }

    :global(html[data-stage="intro"]) .opening > *,
    :global(html[data-stage="greeting"]) .opening > :not(.greeting) {
      visibility: hidden;
      opacity: 0;
      transition: none;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* Solo en las escenas con símbolo o panel: las demás conservan el título de siempre. */
  .scene__body h2,
  .panel h2 {
    margin: 0.3em 0 0.4em;
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  /* El cierre: una sola columna centrada, igual en un teléfono que en escritorio.
     El título queda justo en el centro de la pantalla; el logo, encima. */
  .finale {
    position: relative;
    justify-content: flex-start;
    align-items: center;
    /* Medio título por encima del centro: su línea mide 1,2 veces la letra. */
    padding: calc(50svh - 0.6 * var(--text-lg)) var(--space-gutter) var(--space-gutter);
    text-align: center;
  }

  /* El logo lo arma el lienzo: su dibujo acaba al 40 % de la pantalla. Sin lienzo
     animado (movimiento reducido) se ve esta imagen en el mismo sitio. Su dibujo
     ocupa del 24 % al 76 % de su alto. */
  .finale__mark {
    position: absolute;
    top: calc(40svh - 0.76 * 30svh);
    left: 50%;
    width: auto;
    height: 30svh;
    visibility: hidden;
    transform: translateX(-50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .finale__mark {
      visibility: visible;
    }
  }

  .panel {
    max-width: 44ch;
  }

  .panel h2 {
    margin-top: 0;
  }

  .contact {
    justify-content: center;
    padding: 0;
    list-style: none;
  }

  .signature {
    margin-top: 2.4em;
  }
</style>
