<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="visually-hidden">Luis Rodríguez — NeoBmo</h1>
</section>

<script is:inline>
  // Antes de pintar nada: con la intro en marcha, el contenido espera oculto. Si el
  // script principal no llega a montarse, se muestra igualmente.
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const root = document.documentElement;
    root.dataset.stage = "intro";
    setTimeout(() => {
      if (!("hero" in root.dataset)) delete root.dataset.stage;
    }, 6000);
  }
</script>

<script>
  import { mountHero } from "../scripts/hero";

  mountHero();
</script>

<style>
  /* La intro ocurre en el lienzo fijo, sobre la primera escena: el hero no ocupa
     sitio. Sin movimiento sí: es la pantalla de la pintura fija. */
  .hero {
    height: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: 100svh;
    }
  }
</style>
