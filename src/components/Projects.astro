---
import { getCollection, render } from "astro:content";
import Sheet from "./Sheet.astro";
import { href } from "../lib/url";

const entries = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
// El texto completo de cada proyecto va en la portada, en su ventana de lectura.
const projects = await Promise.all(
  entries.map(async (entry) => ({ ...entry, Content: (await render(entry)).Content })),
);
const total = String(projects.length).padStart(2, "0");
---

{
  projects.length > 0 && (
    <section id="proyectos" aria-labelledby="projects-title">
      <h2 id="projects-title" class="visually-hidden">
        Proyectos
      </h2>
      {projects.map(({ id, data, Content }, index) => (
        <article
          class="scene reading"
          data-symbol={data.symbol}
          id={`proyecto-${id}`}
          aria-labelledby={`${id}-title`}>
          <div class="scene__body">
            <p class="scene__note">
              Proyectos · {String(index + 1).padStart(2, "0")}/{total}
            </p>
            <h3 id={`${id}-title`}>{data.title}</h3>
            <p class="scene__note">
              {data.status} · {data.strength}
            </p>
            <p>{data.summary}</p>
            {data.stack.length > 0 && (
              <ul class="stack" aria-label="Tecnologías">
                {data.stack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            <p class="scene__links">
              {data.site && (
                <a href={data.site} aria-label={`Ver el sitio de ${data.title}`}>
                  Ver sitio
                </a>
              )}
              {data.repo && (
                <a href={data.repo} aria-label={`Ver el código de ${data.title}`}>
                  Ver código
                </a>
              )}
              <a
                href={href(`proyectos/${id}`)}
                aria-label={`Leer más sobre ${data.title}`}
                data-sheet={`leer-${id}`}
              >
                Leer más
              </a>
            </p>
          </div>
          <Sheet id={`leer-${id}`} title={data.title}>
            <p class="scene__note">
              {data.status} · {data.strength}
            </p>
            <Content />
            {/* Al terminar de leer, el siguiente paso está a mano sin cerrar la ventana.
                Herramientas y enlaces salen del frontmatter, igual que en la tarjeta. */}
            {(data.stack.length > 0 || data.site || data.repo) && (
              <footer class="sheet-foot">
                {data.stack.length > 0 && <p class="sheet-foot__stack">{data.stack.join(" · ")}</p>}
                {(data.site || data.repo) && (
                  <p class="scene__links">
                    {data.site && (
                      <a href={data.site} aria-label={`Ver el sitio de ${data.title}`}>
                        Ver sitio
                      </a>
                    )}
                    {data.repo && (
                      <a href={data.repo} aria-label={`Ver el código de ${data.title}`}>
                        Ver código
                      </a>
                    )}
                  </p>
                )}
              </footer>
            )}
          </Sheet>
        </article>
      ))}
    </section>
  )
}

<style>
  h3 {
    margin: 0.4em 0 0.2em;
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em 1.2em;
    margin: 1em 0 0;
    padding: 0;
    font-size: var(--text-sm);
    color: var(--color-dim);
    list-style: none;
  }

  /* El cierre de la ventana: una línea separa lo leído de lo que sigue. */
  .sheet-foot {
    margin-top: 2.2em;
    padding-top: 1.2em;
    border-top: 1px dashed var(--color-dim);
  }

  .sheet-foot__stack {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-dim);
  }

  .sheet-foot .scene__links {
    margin-top: 1em;
  }
</style>
