---
import { getCollection } from "astro:content";
import { href } from "../lib/url";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const total = String(projects.length).padStart(2, "0");
---

{
  projects.length > 0 && (
    <section id="proyectos" aria-labelledby="projects-title">
      <h2 id="projects-title" class="visually-hidden">
        Proyectos
      </h2>
      {projects.map(({ id, data }, index) => (
        <article class="scene reading" data-symbol={data.symbol} aria-labelledby={`${id}-title`}>
          <div class="scene__body">
            <p class="scene__note">
              Proyectos · {String(index + 1).padStart(2, "0")}/{total}
            </p>
            <h3 id={`${id}-title`}>{data.title}</h3>
            <p class="scene__note">
              {data.status} · {data.strength}
            </p>
            <p>{data.summary}</p>
            {data.stack.length > 0 && (
              <ul class="stack" aria-label="Tecnologías">
                {data.stack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            <p class="scene__links">
              {data.site && (
                <a href={data.site} aria-label={`Ver el sitio de ${data.title}`}>
                  Ver sitio
                </a>
              )}
              {data.repo && (
                <a href={data.repo} aria-label={`Ver el código de ${data.title}`}>
                  Ver código
                </a>
              )}
              <a href={href(`proyectos/${id}`)} aria-label={`Leer más sobre ${data.title}`}>
                Leer más
              </a>
            </p>
          </div>
        </article>
      ))}
    </section>
  )
}

<style>
  h3 {
    margin: 0.4em 0 0.2em;
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em 1.2em;
    margin: 1em 0 0;
    padding: 0;
    font-size: var(--text-sm);
    color: var(--color-dim);
    list-style: none;
  }
</style>
