---
import "../styles/global.css";
import fontUrl from "../assets/fonts/jetbrains-mono.woff2?url";
// Importada (no en public/): Astro le pone un hash al nombre, así que cada
// versión nueva tiene otra URL y WhatsApp o LinkedIn no muestran la vieja.
import share from "../assets/share.png";

interface Props {
  title?: string;
  description?: string;
  /** La página no debe salir en buscadores (la de error, por ejemplo). */
  noindex?: boolean;
}

const {
  title = "Luis Rodríguez — NeoBmo",
  description = "Convierto ideas caóticas y procesos anticuados en herramientas simples.",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
// La imagen de las vistas previas: los servicios la piden con dirección completa.
const shareUrl = new URL(share.src, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Luis Rodríguez" />
    <meta name="theme-color" content="#000000" />
    {/* Una página fuera del índice no declara versión canónica: serían señales opuestas. */}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href={`${base.replace(/\/?$/, "/")}favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="NeoBmo" />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:type" content={`image/${share.format}`} />
    <meta property="og:image:width" content={String(share.width)} />
    <meta property="og:image:height" content={String(share.height)} />
    <meta
      property="og:image:alt"
      content="Logo de NeoBmo junto a La noche estrellada dibujada con caracteres de terminal"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareUrl} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
